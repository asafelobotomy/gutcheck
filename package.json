{
  "name": "gutcheck",
  "productName": "GutCheck",
  "version": "0.2.1",
  "description": "Workspace-wide GitHub health dashboard built on the gh CLI",
  "main": "src/main.js",
  "author": "solon",
  "license": "MIT",
  "scripts": {
    "start": "electron . --no-sandbox",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.solon.gutcheck",
    "productName": "GutCheck",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "artifactName": "GutCheck-${version}-${arch}.AppImage"
    },
    "directories": {
      "output": "dist"
    }
  }
}
