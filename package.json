{
  "name": "gutcheck",
  "productName": "GutCheck",
  "version": "0.15.0",
  "description": "Workspace-wide GitHub health dashboard built on the gh CLI",
  "main": "src/entry.js",
  "bin": {
    "gutcheck": "src/cli.js"
  },
  "author": "solon",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron . --no-sandbox",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.1",
    "jsdom": "^31.0.0"
  },
  "build": {
    "appId": "dev.solon.gutcheck",
    "productName": "GutCheck",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "src/assets/icon.png",
      "artifactName": "GutCheck-${version}-${arch}.AppImage"
    },
    "directories": {
      "output": "dist"
    },
    "publish": null
  },
  "allowScripts": {
    "electron@45.2.3": true
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.4": "^11.0.4"
  }
}
